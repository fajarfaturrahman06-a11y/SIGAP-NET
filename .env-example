# Database credentials untuk Docker Compose
MYSQL_DATABASE=mikrobackup
MYSQL_USER=mikrobackup_user
MYSQL_PASSWORD=passwordkuat
MYSQL_ROOT_PASSWORD=root_password_sangat_kuat

# DB url prod dan dev jika tidak pakai docker compose
DATABASE_URL=mysql+pymysql://mikrobackup_user:passwordkuat@db:3306/mikrobackup

# Konfigurasi Flask
# bisa pakai : python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti_dengan_string_acak_yang_sangat_panjang_dan_aman
# Kunci enkripsi kredensial router. WAJIB dipertahankan lintas deploy/container:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Jika kosong, aplikasi memakai file data/.encryption_key (jangan dihapus).
ENCRYPTION_KEY=
# Set "true" jika sudah pakai HTTPS di production, biarkan "false" untuk dev
SESSION_COOKIE_SECURE=false
# Aktifkan hanya jika aplikasi berada di belakang reverse proxy tepercaya.
TRUST_PROXY_HEADERS=false
FLASK_ENV=production

# Optional: buat admin dari environment saat startup (flask ensure-admin).
# Biarkan kosong agar tidak ada akun dengan password default. Minimal 12 karakter,
# wajib huruf besar/kecil, angka, simbol, dan tidak boleh mengandung username.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Akun demo hanya dibuat lewat perintah eksplisit `flask seed-demo-users`.
# Variabel ini dicadangkan untuk kompatibilitas.
SIGAP_SEED_DEMO_USERS=false
SIGAP_SHOW_DEMO_ACCOUNTS=false

# Dicadangkan untuk masa depan. Restore perangkat nyata belum diimplementasikan
# dan tetap diblokir walaupun nilai ini diubah menjadi true.
SIGAP_ALLOW_REAL_RESTORE=false

# Login throttling berbasis database (lintas worker/Gunicorn).
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

# File known_hosts untuk verifikasi host key SSH (opsional; default ~/.ssh/known_hosts).
SSH_KNOWN_HOSTS_FILE=
